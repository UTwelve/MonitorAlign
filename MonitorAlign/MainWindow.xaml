<ui:FluentWindow x:Class="MonitorAlign.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:loc="clr-namespace:MonitorAlign"
                xmlns:pages="clr-namespace:MonitorAlign.Pages"
                Title="{x:Static loc:Loc.WindowTitle}"
                Icon="Resources/app.ico"
                Width="560"
                SizeToContent="Height"
                WindowStartupLocation="CenterScreen"
                ResizeMode="CanMinimize"
                UseLayoutRounding="True"
                ExtendsContentIntoTitleBar="True"
                WindowBackdropType="Mica"
                WindowCornerPreference="Round">

    <!--
        窗口完全交给 Wpf.Ui（lepoco/wpfui）：
          ExtendsContentIntoTitleBar + WindowBackdropType=Mica + WindowCornerPreference=Round
          这三件事它自己会用正确的顺序调 DWM，并且保证窗口保留 WS_CAPTION
          —— 而 WS_CAPTION 正是系统材质能画出来的硬前提（自己手搓就栽在这）。

        内容面板（NavigationViewContentBackground + 左侧分隔线）保持 WPF-UI
        默认值，与 WPF UI Gallery 完全一致 —— 用户定的总原则：一切以 Gallery 为准。
    -->

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏：拖拽 / 双击最大化 / Snap Layout 都由它接管 -->
        <ui:TitleBar Grid.Row="0"
                     Title="{x:Static loc:Loc.WindowTitle}"
                     Icon="{ui:SymbolIcon DualScreenDesktop20}"
                     ShowMinimize="True"
                     ShowMaximize="False"
                     ShowClose="True"/>

        <!-- 左侧导航栏（WPF-UI 默认风格，紧凑轨道 + 可展开）：
             ①显示器对齐（主业，默认）②边缘泛光 ③扩展功能（占位）；
             底部页脚项是设置。标尺覆盖层只在对齐页显示，切走即隐藏。 -->
        <ui:NavigationView x:Name="Nav" Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsPaneOpen="False"
                           IsPaneToggleVisible="True"
                           IsBackButtonVisible="Collapsed"
                           SelectionChanged="Nav_SelectionChanged">
            <ui:NavigationView.MenuItems>
                <!-- 对齐页必须缓存：页面重建会把 PageHost 抢走又抢回来，缓存可免这一折腾 -->
                <ui:NavigationViewItem x:Name="NavItemAlign"
                                       Content="{x:Static loc:Loc.NavAlign}" TargetPageTag="align"
                                       FocusVisualStyle="{x:Null}"
                                       TargetPageType="pages:AlignPage"
                                       NavigationCacheMode="Required">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DualScreenDesktop20"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{x:Static loc:Loc.NavEdgeGlow}" TargetPageTag="glow"
                                       FocusVisualStyle="{x:Null}"
                                       TargetPageType="pages:EdgeGlowPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Lightbulb20"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{x:Static loc:Loc.NavDev2}" TargetPageTag="dev2"
                                       FocusVisualStyle="{x:Null}"
                                       TargetPageType="pages:DevPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PuzzlePiece20"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <!-- 底部固定项：设置（Gallery 的排法） -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{x:Static loc:Loc.NavSettings}" TargetPageTag="settings"
                                       FocusVisualStyle="{x:Null}"
                                       TargetPageType="pages:SettingsPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings20"/>
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- 对齐页内容（PageHost）。
             先挂在根 Grid 下只为 x:Name 接线 —— AlignPage 第一次显示时会
             把它摘走挂成自己的 Content；初始 Hidden 是防导航完成前闪一帧。
             页边距 48 与 Gallery 一致（内容面板左缘到卡片）。 -->
        <Grid x:Name="PageHost" Grid.Row="1" Visibility="Hidden">
            <ScrollViewer x:Name="PageAlign"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="48,16,48,24">

                <!-- 页标题用 Title 字号（28），对齐系统「设置」页的排版。
                     Foreground 必须显式给：进了 NavigationView 的 Frame 之后
                     前景色继承链在 Page 边界断掉，默认样式会回落成黑色 -->
                <ui:TextBlock FontTypography="Title" Text="{x:Static loc:Loc.PageTitle}"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <!-- 同时也是状态行：启动时是操作提示，之后显示"已移动/已撤销" -->
                <ui:TextBlock x:Name="TxtStatus" FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap" Margin="0,8,0,0"/>

                <!-- ① 显示器排列（卡片圆角 8、卡间 4，与系统「设置」一致） -->
                <ui:Card Margin="0,14,0,0" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DualScreenDesktop20" FontSize="20"
                                           VerticalAlignment="Center"/>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Text="{x:Static loc:Loc.SectionTarget}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 高度由代码按排列的宽高比算，宽度跟着卡片走；
                             每条接缝的中点画一枚可点击的"接缝点"，点击即切换要对齐的接缝 -->
                        <Canvas x:Name="TopologyCanvas" Height="84" Margin="0,16,0,0"
                                SizeChanged="TopologyCanvas_SizeChanged"/>

                        <ui:TextBlock x:Name="TxtSeamLabel" FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                      Margin="0,12,0,0"/>

                        <!-- 物理换算：告诉用户 1 像素在这台屏上到底是多宽 -->
                        <ui:TextBlock x:Name="TxtScale" FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- ② 读数 -->
                <ui:Card Margin="0,4,0,0" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="AlignCenterVertical24" FontSize="20"
                                           VerticalAlignment="Center"/>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Text="{x:Static loc:Loc.SectionReadout}"
                                          Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0" FontTypography="Body"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="{x:Static loc:Loc.MetricSeamError}"/>
                            <ui:TextBlock Grid.Column="1" x:Name="TxtError"
                                          FontTypography="BodyStrong"
                                          Text="{x:Static loc:Loc.Dash}"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Grid.Column="0" FontTypography="Body"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="{x:Static loc:Loc.MetricApplied}"/>
                            <ui:TextBlock Grid.Column="1" x:Name="TxtApplied"
                                          FontTypography="BodyStrong"
                                          Text="{x:Static loc:Loc.ZeroPx}"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- ③ 唯一操作：撤销到启动前 -->
                <ui:Button x:Name="BtnUndo" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Icon="{ui:SymbolIcon ArrowUndo24}"
                           Content="{x:Static loc:Loc.BtnUndoAll}"
                           ToolTip="{x:Static loc:Loc.TooltipUndoAll}"
                           HorizontalAlignment="Left" Margin="0,16,0,0"
                           IsEnabled="False" Click="BtnUndo_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
