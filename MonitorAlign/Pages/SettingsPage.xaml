<Page x:Class="MonitorAlign.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:MonitorAlign">
    <!-- 设置页（导航底部固定项，Gallery 的排法）：
         主题循环 / 开机自启 / 关于（作者+版本）。
         文本一律显式 Foreground（Frame/Page 边界断继承链）。 -->
    <StackPanel x:Name="Root" Margin="48,16,48,24">
        <ui:TextBlock FontTypography="Title" Text="{x:Static loc:Loc.NavSettings}"
                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <ui:TextBlock FontTypography="Body" Text="{x:Static loc:Loc.SettingsDesc}"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      TextWrapping="Wrap" Margin="0,8,0,0"/>

        <!-- 主题：三态循环按钮（跟随系统→浅色→深色），图标即当前态 -->
        <ui:Card Margin="0,14,0,0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="CircleHalfFill20" FontSize="20" VerticalAlignment="Center"/>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static loc:Loc.SettingsTheme}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ui:Button x:Name="BtnTheme" Grid.Column="1" Appearance="Secondary"
                           Icon="{ui:SymbolIcon CircleHalfFill20}"
                           Padding="10,6" Click="BtnTheme_Click"/>
            </Grid>
        </ui:Card>

        <!-- 开机自启：注册 HKCU Run，带 background 参数启动（托盘常驻） -->
        <ui:Card Margin="0,4,0,0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Rocket20" FontSize="20" VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static loc:Loc.SettingsAutostart}"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <ui:TextBlock FontTypography="Caption" Text="{x:Static loc:Loc.SettingsAutostartHint}"
                                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <ui:ToggleSwitch x:Name="ToggleAutoStart" Grid.Column="1" VerticalAlignment="Center"
                                 Click="ToggleAutoStart_Click"/>
            </Grid>
        </ui:Card>

        <!-- 关于 -->
        <ui:Card Margin="0,4,0,0" Padding="16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Info20" FontSize="20" VerticalAlignment="Center"/>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static loc:Loc.SettingsAbout}"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                  Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:HyperlinkButton x:Name="BtnAuthor"
                                        Content="{x:Static loc:Loc.ByAuthor}"
                                        ToolTip="{x:Static loc:Loc.TooltipOpenGithub}"
                                        Click="BtnAuthor_Click"/>
                    <ui:TextBlock x:Name="TxtVersion" FontTypography="Caption"
                                  Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                  Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
