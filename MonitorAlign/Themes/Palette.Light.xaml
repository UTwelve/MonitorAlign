<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 说明见 Palette.Dark.xaml：只放 Wpf.Ui 没有的键 -->

  <!-- 拓扑缩略图配色：浅色下强调色用 #0067C0，其余用黑灰阶 -->
  <SolidColorBrush x:Key="MaTopoPrimaryFillBrush"     Color="#0067C0" Opacity="0.12"/>
  <SolidColorBrush x:Key="MaTopoPrimaryStrokeBrush"   Color="#0067C0"/>
  <SolidColorBrush x:Key="MaTopoDepth1FillBrush"      Color="#000000" Opacity="0.08"/>
  <SolidColorBrush x:Key="MaTopoDepth1StrokeBrush"    Color="#000000" Opacity="0.48"/>
  <SolidColorBrush x:Key="MaTopoDepth2FillBrush"      Color="#000000" Opacity="0.05"/>
  <SolidColorBrush x:Key="MaTopoDepth2StrokeBrush"    Color="#000000" Opacity="0.30"/>

  <!-- 覆盖层上的对齐标尺：浅色壁纸 → 深色主体 + 亮色描边 -->
  <SolidColorBrush x:Key="MaMarkerBrush"              Color="#0067C0"/>
  <SolidColorBrush x:Key="MaMarkerOutlineBrush"       Color="#FFFFFF"/>
  <SolidColorBrush x:Key="MaMarkerPanelBrush"         Color="#FFFFFF" Opacity="0.94"/>
  <SolidColorBrush x:Key="MaMarkerTextBrush"          Color="#1B1B1B"/>
</ResourceDictionary>
