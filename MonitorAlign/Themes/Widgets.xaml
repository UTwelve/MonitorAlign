<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    覆盖层（OverlayWindow）上的自绘控件样式。
    这些控件不在 Wpf.Ui 的管辖范围内 —— 覆盖层是逐像素自绘的、要能点击穿透，
    所以样式也自己带。颜色统一走 Ma* 前缀的动态画刷，主题切换时自动跟着变。
  -->

  <!-- 参考物旁边的 ±1px 微调按钮：长按自动连发，必须在任意壁纸上都可辨识 -->
  <Style x:Key="OverlayRepeatButton" TargetType="RepeatButton">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource MaMarkerTextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource MaMarkerPanelBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MaMarkerBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Delay" Value="400"/>
    <Setter Property="Interval" Value="70"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaMarkerBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource MaMarkerOutlineBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaMarkerBrush}"/>
              <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
              <Setter Property="Foreground" Value="{DynamicResource MaMarkerOutlineBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
