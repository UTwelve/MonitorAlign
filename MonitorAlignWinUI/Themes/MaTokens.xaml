<?xml version="1.0" encoding="utf-8"?>
<!--
    自定义令牌（WinUI 3 版）。
    与 WPF 版同色同义：拓扑图的主屏/一层/二层三档配色。
    命名一律 Ma 前缀 —— Wpf.Ui / WinUI 的标准令牌绝不覆盖（覆盖会让换肤失效）。

    ThemeDictionaries 是 WinUI 的明暗两套写法：Light / Dark 两个键，
    运行时按系统主题自动切换，XAML 里一律 {ThemeResource} 引用。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- 泛光的缺省色（接缝没自定义时）。与拓扑图主屏同一支蓝。 -->
            <SolidColorBrush x:Key="MaAccentBrush" Color="#0067C0"/>
            <SolidColorBrush x:Key="MaTopoPrimaryFillBrush" Color="#0067C0" Opacity="0.12"/>
            <SolidColorBrush x:Key="MaTopoPrimaryStrokeBrush" Color="#0067C0"/>
            <SolidColorBrush x:Key="MaTopoDepth1FillBrush" Color="#000000" Opacity="0.08"/>
            <SolidColorBrush x:Key="MaTopoDepth1StrokeBrush" Color="#000000" Opacity="0.48"/>
            <SolidColorBrush x:Key="MaTopoDepth2FillBrush" Color="#000000" Opacity="0.05"/>
            <SolidColorBrush x:Key="MaTopoDepth2StrokeBrush" Color="#000000" Opacity="0.30"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="MaAccentBrush" Color="#4CC2FF"/>
            <SolidColorBrush x:Key="MaTopoPrimaryFillBrush" Color="#4CC2FF" Opacity="0.18"/>
            <SolidColorBrush x:Key="MaTopoPrimaryStrokeBrush" Color="#4CC2FF"/>
            <SolidColorBrush x:Key="MaTopoDepth1FillBrush" Color="#FFFFFF" Opacity="0.12"/>
            <SolidColorBrush x:Key="MaTopoDepth1StrokeBrush" Color="#FFFFFF" Opacity="0.60"/>
            <SolidColorBrush x:Key="MaTopoDepth2FillBrush" Color="#FFFFFF" Opacity="0.07"/>
            <SolidColorBrush x:Key="MaTopoDepth2StrokeBrush" Color="#FFFFFF" Opacity="0.38"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
