<?xml version="1.0" encoding="utf-8"?>
<!--
    设置页（导航底部固定项）：主题选择 / 开机自启 / 关于。
-->
<Page
    x:Class="MonitorAlign.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:MonitorAlign"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24,20,24,24" MaxWidth="880" HorizontalAlignment="Stretch">

            <TextBlock Text="{x:Bind loc:Loc.NavSettings}"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="{x:Bind loc:Loc.SettingsDesc}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>

            <!-- 主题：原生下拉选择，直接展示三个选项 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind loc:Loc.SettingsTheme}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="150"
                              SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                              AutomationProperties.Name="{x:Bind loc:Loc.SettingsTheme}">
                        <ComboBoxItem Content="{x:Bind loc:Loc.ThemeAuto}"/>
                        <ComboBoxItem Content="{x:Bind loc:Loc.ThemeLight}"/>
                        <ComboBoxItem Content="{x:Bind loc:Loc.ThemeDark}"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- 开机自启：注册 HKCU 的 Run 键，以后台形态启动 -->
            <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind loc:Loc.SettingsAutostart}"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind loc:Loc.SettingsAutostartHint}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                  IsOn="{x:Bind ViewModel.AutoStart, Mode=TwoWay}"
                                  OnContent="{x:Bind loc:Loc.ToggleOn}"
                                  OffContent="{x:Bind loc:Loc.ToggleOff}"
                                  AutomationProperties.Name="{x:Bind loc:Loc.SettingsAutostart}"/>
                </Grid>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="{x:Bind loc:Loc.SettingsAbout}"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                    <StackPanel Margin="0,12,0,0" Spacing="4">
                        <HyperlinkButton HorizontalAlignment="Left"
                                         NavigateUri="{x:Bind ViewModel.AuthorUri}"
                                         ToolTipService.ToolTip="{x:Bind loc:Loc.TooltipOpenGithub}">
                            <TextBlock Text="{x:Bind loc:Loc.ByAuthor}" TextWrapping="Wrap"/>
                        </HyperlinkButton>
                        <TextBlock Text="{x:Bind loc:Loc.AppVersion}"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
