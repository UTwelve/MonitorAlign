<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MonitorAlign.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:MonitorAlign">

    <!-- App shell（winui3-skills app-shell 模式）：
         48px 自绘标题行（拖拽区）+ NavigationView 左导航。
         导航四项：对齐 / 边缘泛光 / 扩展（预留）+ 底部设置。
         WinUI 3 没有 x:Static —— 静态词条用 x:Bind 静态路径（Loc 在页面创建前已 Init）。
         全部文本显式给 ThemeResource 令牌；交互控件一律 AutomationProperties.Name。 -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自绘标题栏（ExtendsContentIntoTitleBar 的拖拽区） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7F4;" FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind loc:Loc.WindowTitle}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView" Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="1008"
            IsPaneToggleButtonVisible="True"
            OpenPaneLength="240"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavItemAlign" Tag="align"
                                    Content="{x:Bind loc:Loc.NavAlign}"
                                    AutomationProperties.Name="{x:Bind loc:Loc.NavAlign}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemGlow" Tag="glow"
                                    Content="{x:Bind loc:Loc.NavEdgeGlow}"
                                    AutomationProperties.Name="{x:Bind loc:Loc.NavEdgeGlow}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE793;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemDev" Tag="dev"
                                    Content="{x:Bind loc:Loc.NavDev2}"
                                    AutomationProperties.Name="{x:Bind loc:Loc.NavDev2}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavItemSettings" Tag="settings"
                                    Content="{x:Bind loc:Loc.NavSettings}"
                                    AutomationProperties.Name="{x:Bind loc:Loc.NavSettings}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Page>
